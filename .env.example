# Proveedor: openrouter (real) | mock (solo desarrollo y tests, sin red ni coste)
LLM_PROVIDER=openrouter

# OpenRouter (una sola clave para todos los modelos). No subir nunca al repositorio.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos por rol (se eligen en Ajustes desde el catálogo; los IDs cambian con frecuencia)
LLM_MODEL=                          # juez, intake, revisor
LLM_MODEL_WRITER=                   # estrategia y redacción
LLM_MODEL_PROPOSER=                 # propuesta de marcas y banco de prompts (con búsqueda web)
ENGINE_MODEL_CHATGPT=
ENGINE_MODEL_GEMINI=
ENGINE_MODEL_CLAUDE=
ENGINE_MODEL_PERPLEXITY=

# Límites
LLM_CONCURRENCY=8
MAX_LLM_CALLS=3000
MAX_BUDGET_EUR=15.0
USD_EUR=0.92

# Servidor local
GEO_DATA_DIR=./data
GEO_HOST=127.0.0.1
GEO_PORT=8000
